# Meta / Instagram Graph API Configuration (100% FREE)
# Agar abhi credentials nahi hain, toh server automatically realistic Demo/Mock Mode mein chalega
MOCK_MODE=True

# Meta Developer Portal se milne wale details:
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_60_day_long_lived_access_token
META_APP_SECRET=your_facebook_app_secret
META_VERIFY_TOKEN=insta_hub_secret_verify_token_2026

# Server & Storage Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./insta_hub.db
MEDIA_DIR=./media
ALLOWED_ORIGINS=*
